@model List<Product>
@{
    ViewData["Title"] = "Manage Products";
    var categories = (List<string>)ViewBag.Categories;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Manage Products</h2>
    <a class="btn btn-primary" asp-action="Create">+ Add Product</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-12 col-md-5">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by name" />
    </div>
    <div class="col-8 col-md-4">
        <select name="category" class="form-select">
            <option value="">All categories</option>
            @foreach (var c in categories)
            {
                <option value="@c" selected="@(c == (string?)ViewBag.Category)">@c</option>
            }
        </select>
    </div>
    <div class="col-4 col-md-3 d-grid">
        <button class="btn btn-outline-secondary" type="submit">Filter</button>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Name</th><th>Category</th><th>Price</th><th>Stock</th><th>Status</th><th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.Name</td>
                    <td>@p.Category</td>
                    <td>&#8377;@p.Price.ToString("0.00")</td>
                    <td>@p.StockQuantity</td>
                    <td>@(p.IsActive ? "Active" : "Hidden")</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@p.Id">Edit</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@p.Id">Delete</a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="6" class="text-center text-muted">No products found.</td></tr>
            }
        </tbody>
    </table>
</div>
