@model Product
@{
    ViewData["Title"] = "Delete Product";
}
<h2>Delete Product</h2>
<p class="text-danger">Are you sure you want to delete this product?</p>
<dl class="row">
    <dt class="col-sm-3">Name</dt><dd class="col-sm-9">@Model.Name</dd>
    <dt class="col-sm-3">Category</dt><dd class="col-sm-9">@Model.Category</dd>
    <dt class="col-sm-3">Price</dt><dd class="col-sm-9">&#8377;@Model.Price.ToString("0.00")</dd>
</dl>
<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a class="btn btn-link" asp-action="Index">Cancel</a>
</form>
